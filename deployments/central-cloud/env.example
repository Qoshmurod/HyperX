# Markaziy (respublika) tugun. Umumiy o'zgaruvchilar ro'yxati: /.env.example
GOVMIND_NODE_ROLE=central
GOVMIND_NODE_ID=node-central
GOVMIND_ROOT_PATH=uz
WEB_BASE_URL=https://govmind.example.uz
KEYCLOAK_PUBLIC_URL=https://govmind.example.uz
OIDC_ISSUER_URL=https://govmind.example.uz/realms/govmind
OLLAMA_URL=http://ollama:11434
LOCAL_MODEL_MAX_CLASSIFICATION=confidential
# Markaziy GPU klasteri (vLLM). Faqat "internal" darajasigacha ma'lumot yuboriladi.
CENTRAL_LLM_URL=http://vllm.internal:8000
CENTRAL_LLM_MODEL=<model-nomi>
# Markaziy tugun eng yuqori — upstream yo'q
UPSTREAM_SYNC_URL=
GOVMIND_LOAD_SEEDS=false
