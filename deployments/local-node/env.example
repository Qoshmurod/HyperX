# Tuman tuguni. Umumiy o'zgaruvchilar ro'yxati: /.env.example
GOVMIND_NODE_ROLE=local
GOVMIND_NODE_ID=node-<tuman-kodi>
GOVMIND_ROOT_PATH=uz.<viloyat>.<tuman>
WEB_BASE_URL=https://govmind.<tuman>.example.uz
KEYCLOAK_PUBLIC_URL=https://govmind.<tuman>.example.uz
OIDC_ISSUER_URL=https://govmind.<tuman>.example.uz/realms/govmind
KEYCLOAK_REALM_DIR=import-prod
# Lokal AI (16 GB+ RAM). Maxfiy ma'lumot faqat shu modelda qayta ishlanadi.
OLLAMA_URL=http://ollama:11434
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct
LOCAL_MODEL_MAX_CLASSIFICATION=confidential
EMBEDDING_MODEL=bge-m3
# Markaziy LLM tuman tugunida ishlatilmaydi
CENTRAL_LLM_URL=
# Viloyat tuguni
UPSTREAM_SYNC_URL=https://govmind.<viloyat>.example.uz
UPSTREAM_SYNC_TOKEN=
GOVMIND_LOAD_SEEDS=false
