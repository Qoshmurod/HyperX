# Nusxa oling: cp .env.example .env  — va barcha parollarni almashtiring.
# Bu faylda haqiqiy parol yoki kalit bo'lmasligi kerak.

# Tugun roli: local | regional | central
GOVMIND_NODE_ROLE=local
GOVMIND_NODE_ID=node-dev-1

# PostgreSQL
POSTGRES_DB=govmind
POSTGRES_USER=govmind_owner
POSTGRES_PASSWORD=change-me
GOVMIND_APP_DB_PASSWORD=change-me-app
GOVMIND_AUDITOR_DB_PASSWORD=change-me-auditor
GOVMIND_LOAD_SEEDS=true
DATABASE_URL=postgresql://govmind_app:change-me-app@localhost:5432/govmind

# Redis
REDIS_PASSWORD=change-me-redis

# MinIO
MINIO_ROOT_USER=govmind
MINIO_ROOT_PASSWORD=change-me-minio

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/govmind

# Servislar
API_PORT=3001
AI_ENGINE_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
