# cp .env.example .env — va BARCHA "change-me" qiymatlarini almashtiring.
# Bu faylda haqiqiy parol yoki kalit bo'lmasligi kerak.
# Tasodifiy qiymat: openssl rand -base64 32

# ---- Tugun ----
# local (tuman) | regional (viloyat) | central (respublika)
GOVMIND_NODE_ROLE=local
GOVMIND_NODE_ID=node-tuman-1
# Ushbu tugun xizmat qiladigan eng yuqori hudud yo'li (administrative_units.path)
GOVMIND_ROOT_PATH=demo.v1.t1

# ---- Manzillar ----
WEB_BASE_URL=https://govmind.example.uz
KEYCLOAK_PUBLIC_URL=https://govmind.example.uz
OIDC_ISSUER_URL=https://govmind.example.uz/realms/govmind

# ---- PostgreSQL ----
POSTGRES_DB=govmind
POSTGRES_USER=govmind_owner
POSTGRES_PASSWORD=change-me
GOVMIND_APP_DB_PASSWORD=change-me-app
GOVMIND_AUDITOR_DB_PASSWORD=change-me-auditor
# Faqat ishlab chiqish/sinov: sintetik demo ma'lumotlar
GOVMIND_LOAD_SEEDS=false

# ---- Maxfiy kalitlar ----
# 32 bayt, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me
AI_ENGINE_TOKEN=change-me
SESSION_SECRET=change-me-at-least-32-characters-long
OIDC_CLIENT_SECRET=change-me
METRICS_TOKEN=change-me

# ---- Redis / MinIO / Keycloak ----
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=govmind
MINIO_ROOT_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# import-prod (foydalanuvchilarsiz) yoki import-demo (demo hisoblar bilan)
KEYCLOAK_REALM_DIR=import-prod
GOVMIND_DEMO_PASSWORD=

# ---- AI ----
# Lokal LLM (docker compose --profile ai): http://ollama:11434
OLLAMA_URL=
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct
LOCAL_MODEL_MAX_CLASSIFICATION=confidential
EMBEDDING_MODEL=
# Markaziy LLM (vLLM, OpenAI-mos). Unga faqat "internal" darajasigacha ma'lumot yuboriladi.
CENTRAL_LLM_URL=
CENTRAL_LLM_MODEL=
CENTRAL_LLM_API_KEY=

# ---- Bildirishnomalar ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GovMind AI <noreply@example.uz>
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Sinxronizatsiya (yuqori tugun) ----
UPSTREAM_SYNC_URL=
UPSTREAM_SYNC_TOKEN=

# ---- Integratsiya ----
# Vergul bilan: faqat shu xostlarga webhook yuboriladi (bo'sh — cheklov yo'q, lekin ichki metadata manzillari baribir taqiqlangan)
WEBHOOK_ALLOWED_HOSTS=

# ---- Monitoring / backup ----
GRAFANA_ADMIN_PASSWORD=change-me
METRICS_TOKEN_FILE=./secrets/metrics_token
BACKUP_DIR=./backups
BACKUP_KEY_FILE=./secrets/backup.key
BACKUP_RETENTION_DAYS=30
TLS_DIR=./infrastructure/nginx/tls
